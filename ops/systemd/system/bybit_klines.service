[Unit]
Description=Bybit 1m klines (bybit_klines, monorepo bybit-research)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vlad
Group=vlad
WorkingDirectory=/home/vlad/Документы/построение/collector
ExecStart=/home/vlad/Документы/построение/collector/target/release/bybit_klines
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/vlad/Документы/построение/collector/logs/bybit_klines.log
StandardError=append:/home/vlad/Документы/построение/collector/logs/bybit_klines.log
Environment=MALLOC_ARENA_MAX=2
MemoryMax=16G
Environment=BYBIT_WS_PROXY=ws://127.0.0.1:8765
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
